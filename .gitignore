# Exported message data must never be committed -- keep it outside this repo
# entirely (the script defaults to ~/iMessage-Vault), but ignore it here too
# in case someone points --output-dir at the repo by mistake.
/messages.json
/messages_data.js
/attachments/
/iMessage-Export/
/iMessage-Vault/
/cloud-backup/

__pycache__/
*.pyc
.DS_Store

# Archives and their chain state hold message data too
*.zip
*.zip.partial
.archive-state.json
chat-backup.db
